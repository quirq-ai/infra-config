{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/quirq-ai/infra-config/schema/perf.schema.json",
  "title": "perf: benchmarks and alert thresholds (stub)",
  "type": "object",
  "additionalProperties": false,
  "required": ["area", "benchmark"],
  "properties": {
    "area": {"$ref": "area.schema.json"},
    "benchmark": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "repo", "measure", "alert_regression_pct"],
        "properties": {
          "name": {"$ref": "area.schema.json#/$defs/name"},
          "repo": {"$ref": "area.schema.json#/$defs/name"},
          "measure": {"type": "string", "minLength": 1},
          "alert_regression_pct": {"type": "number", "minimum": 0}
        }
      }
    }
  }
}
