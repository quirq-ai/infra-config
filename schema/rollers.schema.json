{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/quirq-ai/infra-config/schema/rollers.schema.json",
  "title": "rollers: machine-written dependency updates (stub)",
  "type": "object",
  "additionalProperties": false,
  "required": ["area", "roller"],
  "properties": {
    "area": {"$ref": "area.schema.json"},
    "roller": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "repos", "moves", "tool", "cadence"],
        "properties": {
          "name": {"$ref": "area.schema.json#/$defs/name"},
          "repos": {"$ref": "area.schema.json#/$defs/names", "minItems": 1},
          "moves": {"type": "string", "minLength": 1},
          "tool": {"enum": ["dependabot", "renovate", "quirq-rollers"]},
          "cadence": {"enum": ["daily", "weekly", "biweekly"]}
        }
      }
    }
  }
}
