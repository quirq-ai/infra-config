{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/quirq-ai/infra-config/schema/kinds.schema.json",
  "title": "kinds: toolchains, target kinds and their capabilities",
  "type": "object",
  "additionalProperties": false,
  "required": ["area", "toolchain", "kind"],
  "properties": {
    "area": {"$ref": "area.schema.json"},
    "toolchain": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "track", "pin"],
        "properties": {
          "name": {"$ref": "area.schema.json#/$defs/name"},
          "track": {"enum": ["latest", "lts", "pinned"]},
          "pin": {"type": "string", "minLength": 1},
          "github": {
            "type": "object",
            "additionalProperties": false,
            "required": ["uses", "version_input"],
            "properties": {
              "uses": {"type": "string", "minLength": 1},
              "version_input": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "kind": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "phase", "capabilities"],
        "properties": {
          "name": {"$ref": "area.schema.json#/$defs/name"},
          "phase": {"enum": ["year-one", "later"]},
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/capability"}
          },
          "toolchain": {"$ref": "area.schema.json#/$defs/name"},
          "test_reports": {
            "description": "JUnit XML globs the interim test command writes, relative to the workspace.",
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "string", "pattern": "^(?!.*(^|/)\\.\\.(/|$))[^\\s/][^\\s]*$"}
          },
          "interim": {
            "type": "object",
            "propertyNames": {"$ref": "#/$defs/capability"},
            "additionalProperties": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  },
  "$defs": {"capability": {"enum": ["fetch", "build", "test", "package", "run", "deploy", "bench", "fuzz"]}}
}
