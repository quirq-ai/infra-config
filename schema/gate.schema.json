{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/quirq-ai/infra-config/schema/gate.schema.json",
  "title": "gate: the landing gate and who may land what",
  "type": "object",
  "additionalProperties": false,
  "required": ["area", "merge_queue", "admission", "verification_surface", "change_class", "tree_status"],
  "properties": {
    "area": {"$ref": "area.schema.json"},
    "merge_queue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "merge_method", "required"],
      "properties": {
        "backend": {"$ref": "area.schema.json#/$defs/name"},
        "merge_method": {"enum": ["squash", "merge", "rebase"]},
        "required": {"enum": ["blocking-builders"]}
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_p50_minutes", "max_minutes", "needs_postsubmit_mirror"],
      "properties": {
        "max_p50_minutes": {"type": "integer", "minimum": 1},
        "max_minutes": {"type": "integer", "minimum": 1},
        "needs_postsubmit_mirror": {"type": "boolean"}
      }
    },
    "verification_surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths", "author_may_approve"],
      "properties": {
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "author_may_approve": {"type": "boolean"}
      }
    },
    "change_class": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "approval", "matches"],
        "properties": {
          "name": {"$ref": "area.schema.json#/$defs/name"},
          "approval": {"$ref": "area.schema.json#/$defs/approval"},
          "matches": {"type": "string", "minLength": 1}
        }
      }
    },
    "tree_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["closes_on"],
      "properties": {"closes_on": {"$ref": "area.schema.json#/$defs/names"}}
    }
  }
}
