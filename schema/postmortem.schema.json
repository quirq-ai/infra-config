{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/quirq-ai/infra-config/schema/postmortem.schema.json",
  "title": "postmortem: policy and failure tracking",
  "type": "object",
  "additionalProperties": false,
  "required": ["area", "policy", "recurrence", "trigger"],
  "properties": {
    "area": {"$ref": "area.schema.json"},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blameless",
        "tracker",
        "label",
        "drafted_by",
        "reviewed_by",
        "draft_within_hours",
        "action_items_need_issue",
        "record_needs",
        "template",
        "lives_in"
      ],
      "properties": {
        "blameless": {"type": "boolean"},
        "tracker": {"enum": ["github-issues"]},
        "label": {"type": "string", "minLength": 1},
        "drafted_by": {"enum": ["agent", "owner"]},
        "reviewed_by": {"enum": ["owner", "policy-owner"]},
        "draft_within_hours": {"type": "integer", "minimum": 1},
        "action_items_need_issue": {"type": "boolean"},
        "template": {"type": "string", "pattern": "^templates/[a-z0-9_-]+\\.md$"},
        "lives_in": {"enum": ["issue"]},
        "record_needs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["culprit", "fix", "covering-test"]}
        }
      }
    },
    "recurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["same_class_count", "window_days", "opens", "closed_by"],
      "properties": {
        "same_class_count": {"type": "integer", "minimum": 2},
        "window_days": {"type": "integer", "minimum": 1},
        "opens": {"const": "close-the-class"},
        "closed_by": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["test", "fuzz-target", "fuzz-corpus-entry", "gate", "health-signal"]}
        }
      }
    },
    "trigger": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event", "postmortem"],
        "properties": {
          "event": {"$ref": "area.schema.json#/$defs/name"},
          "postmortem": {"enum": ["required", "stub", "track"]}
        }
      }
    }
  }
}
